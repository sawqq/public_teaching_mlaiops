+#!/usr/bin/env bash
+# Lab 4 — create the monitoring pieces for the prediction service on GCP.
+#
+#   PROJECT_ID=itcs355-<id> ALERT_EMAIL=you@example.com bash monitoring/gcp/setup.sh
+#
+# Creates, idempotently:
+#   1. four log-based metrics read from the service's JSON access log
+#      (requests by model version, 4xx, 5xx, latency distribution)
+#   2. an email notification channel
+#   3. an alert policy: any drift.psi.<feature> metric above 0.15 sends the email
+#   4. the dashboard (monitoring/gcp/dashboard.json)
+#
+# The service already logs one JSON line per request (service/app.py):
+#   {"ts": ..., "level": "INFO", "msg": {"request_id": ..., "path": "/predict",
+#    "status": 200, "latency_ms": 3.2, "model_version": "<sha>"}}
+# Cloud Logging parses that into jsonPayload.msg.*, which is what the filters below read.
+# Before running this, confirm those fields exist: Logs Explorer, send one request, open the
+# entry. If the Vertex endpoint shows no container logs, enable container logging on deploy.
+
+set -euo pipefail
+
+: "${PROJECT_ID:?set PROJECT_ID}"
+: "${ALERT_EMAIL:?set ALERT_EMAIL (where the drift alert should be sent)}"
+HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
+TMP="$(mktemp -d)"
+trap 'rm -rf "$TMP"' EXIT
+
+BASE_FILTER='resource.type="aiplatform.googleapis.com/Endpoint" AND jsonPayload.msg.path="/predict"'
+
+upsert_metric() {   # name, config file
+  if gcloud logging metrics describe "$1" --project "$PROJECT_ID" >/dev/null 2>&1; then
+    gcloud logging metrics update "$1" --project "$PROJECT_ID" --config-from-file="$2"
+  else
+    gcloud logging metrics create "$1" --project "$PROJECT_ID" --config-from-file="$2"
+  fi
+}
+
+cat > "$TMP/requests.yaml" <<EOF
+description: "ITCS355 /predict requests, by model version"
+filter: '${BASE_FILTER}'
+metricDescriptor:
+  metricKind: DELTA
+  valueType: INT64
+  unit: "1"
+  labels:
+  - key: model_version
+    valueType: STRING
+labelExtractors:
+  model_version: EXTRACT(jsonPayload.msg.model_version)
+EOF
+
+cat > "$TMP/4xx.yaml" <<EOF
+description: "ITCS355 /predict responses with a 4xx status (caller problems)"
+filter: '${BASE_FILTER} AND jsonPayload.msg.status>=400 AND jsonPayload.msg.status<500'
+metricDescriptor:
+  metricKind: DELTA
+  valueType: INT64
+  unit: "1"
+EOF
+
+cat > "$TMP/5xx.yaml" <<EOF
+description: "ITCS355 /predict responses with a 5xx status (our problems)"
+filter: '${BASE_FILTER} AND jsonPayload.msg.status>=500'
+metricDescriptor:
+  metricKind: DELTA
+  valueType: INT64
+  unit: "1"
+EOF
+
+cat > "$TMP/latency.yaml" <<EOF
+description: "ITCS355 /predict latency in ms, measured inside the service"
+filter: '${BASE_FILTER}'
+valueExtractor: EXTRACT(jsonPayload.msg.latency_ms)
+metricDescriptor:
+  metricKind: DELTA
+  valueType: DISTRIBUTION
+  unit: ms
+bucketOptions:
+  exponentialBuckets:
+    numFiniteBuckets: 48
+    growthFactor: 1.3
+    scale: 1
+EOF
+
+upsert_metric itcs355_predict_requests "$TMP/requests.yaml"
+upsert_metric itcs355_predict_4xx "$TMP/4xx.yaml"
+upsert_metric itcs355_predict_5xx "$TMP/5xx.yaml"
+upsert_metric itcs355_predict_latency_ms "$TMP/latency.yaml"
+
+# --- the channel the drift alert reaches: a real inbox -------------------------------------
+CHANNEL="$(gcloud beta monitoring channels list --project "$PROJECT_ID" \
+  --filter="displayName='itcs355 drift email'" --format='value(name)' | head -n1)"
+if [ -z "$CHANNEL" ]; then
+  CHANNEL="$(gcloud beta monitoring channels create --project "$PROJECT_ID" \
+    --display-name='itcs355 drift email' --type=email \
+    --channel-labels="email_address=${ALERT_EMAIL}" --format='value(name)')"
+fi
+echo "notification channel: $CHANNEL"
+
+# --- alert policy: PSI above the threshold justified in README / monitoring/drift.py -------
+cat > "$TMP/policy.json" <<'EOF'
+{
+  "displayName": "itcs355 drift: PSI above 0.15",
+  "combiner": "OR",
+  "conditions": [
+    {
+      "displayName": "any drift.psi.<feature> >= 0.15",
+      "conditionThreshold": {
+        "filter": "metric.type=starts_with(\"custom.googleapis.com/itcs355/drift.psi.\") AND resource.type=\"global\"",
+        "comparison": "COMPARISON_GT",
+        "thresholdValue": 0.15,
+        "duration": "0s",
+        "aggregations": [
+          {"alignmentPeriod": "300s", "perSeriesAligner": "ALIGN_MAX"}
+        ],
+        "evaluationMissingData": "EVALUATION_MISSING_DATA_INACTIVE"
+      }
+    }
+  ],
+  "alertStrategy": {"autoClose": "1800s"},
+  "documentation": {
+    "content": "A feature's PSI against the training reference crossed 0.15. Before retraining, check whether the schema or null rate changed (broken upstream: do NOT retrain) and see docs/postmortem-template.md.",
+    "mimeType": "text/markdown"
+  }
+}
+EOF
+EXISTING="$(gcloud alpha monitoring policies list --project "$PROJECT_ID" \
+  --filter="displayName='itcs355 drift: PSI above 0.15'" --format='value(name)' | head -n1)"
+if [ -n "$EXISTING" ]; then
+  gcloud alpha monitoring policies delete "$EXISTING" --project "$PROJECT_ID" --quiet
+fi
+gcloud alpha monitoring policies create --project "$PROJECT_ID" \
+  --policy-from-file="$TMP/policy.json" --notification-channels="$CHANNEL"
+
+# --- dashboard ---------------------------------------------------------------------------
+OLD="$(gcloud monitoring dashboards list --project "$PROJECT_ID" \
+  --filter="displayName='ITCS355 - Prediction service'" --format='value(name)' | head -n1)"
+if [ -n "$OLD" ]; then
+  gcloud monitoring dashboards delete "$OLD" --project "$PROJECT_ID" --quiet
+fi
+gcloud monitoring dashboards create --project "$PROJECT_ID" --config-from-file="$HERE/dashboard.json"
+
+echo "done. Log-based metrics take a few minutes to start collecting; they only count requests made AFTER they exist."
diff --git a/scripts/cd_steps.py b/scripts/cd_steps.py
new file mode 100644
index 0000000..12ccb37
--- /dev/null
+++ b/scripts/cd_steps.py
@@ -0,0 +1,108 @@
+"""Lab 4 — the steps of cd.yml, each a thin call through the CloudAdapter seam.
+
+    python scripts/cd_steps.py push   --tag itcs355-serve:<sha>
+    python scripts/cd_steps.py deploy --model-ref <repo@sha256:...> --endpoint NAME --instance TYPE
+    python scripts/cd_steps.py smoke  --endpoint <resource name> --expect-version <sha>
+
+Nothing here knows which cloud it runs on: it only calls adapter.push_image / deploy / invoke,
+so the same workflow survives a provider swap. Each step writes `key=value` to
+$GITHUB_OUTPUT (when set) so the next step can use the result.
+"""
+from __future__ import annotations
+
+import argparse
+import os
+import sys
+from pathlib import Path
+
+sys.path.insert(0, str(Path(__file__).resolve().parents[1]))
+
+from cloudlayer.factory import get_adapter  # noqa: E402
+from src import config  # noqa: E402
+
+# Three known inputs: a machine that should look healthy, the load-test payload, and a worn,
+# hot one. The checks are about shape and ordering, not exact numbers, so they stay valid
+# when the model is retrained.
+HEALTHY = {"temp_c": 66.0, "vibration_mm_s": 1.4, "pressure_kpa": 330.0,
+           "hours_since_service": 50.0, "load_pct": 30.0, "ambient_humidity": 50.0}
+TYPICAL = {"temp_c": 78.4, "vibration_mm_s": 3.1, "pressure_kpa": 315.2,
+           "hours_since_service": 4200.0, "load_pct": 68.0, "ambient_humidity": 55.0}
+WORN = {"temp_c": 82.0, "vibration_mm_s": 4.0, "pressure_kpa": 310.0,
+        "hours_since_service": 8500.0, "load_pct": 75.0, "ambient_humidity": 60.0}
+
+
+def set_output(key: str, value: str) -> None:
+    print(f"{key}={value}")
+    path = os.environ.get("GITHUB_OUTPUT")
+    if path:
+        with open(path, "a", encoding="utf-8") as fh:
+            fh.write(f"{key}={value}\n")
+
+
+def push(adapter, tag: str) -> int:
+    ref = adapter.push_image(tag)
+    if "@sha256:" not in ref:
+        print(f"FAIL  push_image returned {ref!r}; expected a digest reference (repo@sha256:...)")
+        return 1
+    set_output("ref", ref)
+    return 0
+
+
+def deploy(adapter, model_ref: str, endpoint: str, instance: str) -> int:
+    resource = adapter.deploy(model_ref, endpoint, instance)
+    set_output("endpoint", resource)
+    return 0
+
+
+def smoke(adapter, endpoint: str, expect_version: str) -> int:
+    """A deploy that is not smoke-tested is a deploy you have not verified."""
+    failures = []
+    scores = {}
+    for name, payload in (("healthy", HEALTHY), ("typical", TYPICAL), ("worn", WORN)):
+        response = adapter.invoke(endpoint, payload)
+        prob = response.get("probability")
+        version = response.get("model_version")
+        scores[name] = prob
+        if not isinstance(prob, (int, float)) or not 0.0 <= prob <= 1.0:
+            failures.append(f"{name}: probability missing or outside [0, 1]: {prob!r}")
+        if version != expect_version:
+            failures.append(f"{name}: serving version {version!r}, expected {expect_version!r}")
+    if not failures and scores["healthy"] >= scores["worn"]:
+        failures.append(f"ordering: healthy scored {scores['healthy']:.3f}, "
+                        f"worn {scores['worn']:.3f}; risk should be higher for the worn machine")
+    print("scores:", {k: (round(v, 4) if isinstance(v, (int, float)) else v) for k, v in scores.items()})
+    if failures:
+        for line in failures:
+            print("FAIL ", line)
+        return 1
+    print(f"OK  3/3 payloads scored by version {expect_version}")
+    return 0
+
+
+def main() -> int:
+    ap = argparse.ArgumentParser()
+    sub = ap.add_subparsers(dest="step", required=True)
+
+    p = sub.add_parser("push")
+    p.add_argument("--tag", required=True)
+
+    d = sub.add_parser("deploy")
+    d.add_argument("--model-ref", required=True)
+    d.add_argument("--endpoint", required=True)
+    d.add_argument("--instance", required=True)
+
+    s = sub.add_parser("smoke")
+    s.add_argument("--endpoint", required=True)
+    s.add_argument("--expect-version", required=True)
+
+    args = ap.parse_args()
+    adapter = get_adapter(config.load())
+    if args.step == "push":
+        return push(adapter, args.tag)
+    if args.step == "deploy":
+        return deploy(adapter, args.model_ref, args.endpoint, args.instance)
+    return smoke(adapter, args.endpoint, args.expect_version)
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
diff --git a/scripts/drift_job.py b/scripts/drift_job.py
new file mode 100644
index 0000000..54d6d44
--- /dev/null
+++ b/scripts/drift_job.py
@@ -0,0 +1,65 @@
+"""Lab 4 — the scheduled drift run. This is what Cloud Scheduler triggers.
+
+    python scripts/drift_job.py \
+        --reference-uri gs://<bucket>/itcs355/drift/reference.csv \
+        --current-uri   gs://<bucket>/itcs355/drift/current.csv
+
+Downloads both windows through the adapter, scores PSI per feature with the same code as
+`python -m monitoring.drift`, and writes each score as the metric drift.psi.<feature>.
+
+It exits 0 whenever the job itself worked, even when drift was found. The alert comes from
+the metric alert policy (monitoring/gcp/setup.sh), which is what sends the email. If this
+exited non-zero on drift, the scheduler would record a failed run and nobody would learn
+the one thing the job exists to say.
+"""
+from __future__ import annotations
+
+import argparse
+import sys
+import tempfile
+from pathlib import Path
+
+import pandas as pd
+
+sys.path.insert(0, str(Path(__file__).resolve().parents[1]))
+
+from cloudlayer.factory import get_adapter  # noqa: E402
+from monitoring.drift import DRIFT_ALERT_PSI, MIN_WINDOW_ROWS, compare  # noqa: E402
+from src import config, data  # noqa: E402
+
+
+def run(adapter, reference_uri: str, current_uri: str) -> int:
+    with tempfile.TemporaryDirectory() as tmp:
+        ref_path, cur_path = Path(tmp) / "reference.csv", Path(tmp) / "current.csv"
+        adapter.download(reference_uri, str(ref_path))
+        adapter.download(current_uri, str(cur_path))
+        reference, current = pd.read_csv(ref_path), pd.read_csv(cur_path)
+
+    if len(current) < MIN_WINDOW_ROWS:
+        print(f"SKIP  {len(current)} rows in the current window; need {MIN_WINDOW_ROWS}+ for PSI "
+              f"to be meaningful at threshold {DRIFT_ALERT_PSI}")
+        return 0
+
+    results = compare(reference, current, data.FEATURES)
+    for r in results:
+        adapter.emit_metric(f"drift.psi.{r.feature}", r.psi)
+        print(f"{r.feature:<22} psi={r.psi:.5f}  ks={r.ks_statistic:.5f}  {r.verdict}")
+
+    breached = [r.feature for r in results if r.psi >= DRIFT_ALERT_PSI]
+    if breached:
+        print(f"DRIFT  above {DRIFT_ALERT_PSI}: {', '.join(breached)}  (alert policy sends the email)")
+    else:
+        print(f"OK  no feature above {DRIFT_ALERT_PSI}")
+    return 0
+
+
+def main() -> int:
+    ap = argparse.ArgumentParser()
+    ap.add_argument("--reference-uri", required=True)
+    ap.add_argument("--current-uri", required=True)
+    args = ap.parse_args()
+    return run(get_adapter(config.load()), args.reference_uri, args.current_uri)
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
